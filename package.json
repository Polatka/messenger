{
  "name": "polatka",
  "version": "0.4.0",
  "description": "Polatka desktop P2P messenger",
  "author": "Polatka",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "electron-builder --win portable --x64",
    "pack:dir": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.polatka.desktop",
    "productName": "Polatka",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "renderer/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Polatka-${version}-Windows-x64.exe"
    },
    "compression": "normal"
  }
}
